NODE_ENV=development
PORT=3000
ENABLE_SWAGGER=true
LOG_LEVEL=error
ENABLE_FILE_LOGS=false
ENABLE_CONVERSATION_LOGS=false

# Database (docker-compose Postgres)
DATABASE_URL=postgresql://postgres:password@localhost:5432/chatlogix
# Used only by `prisma migrate`/`db push` (schema.prisma declares directUrl). For local
# dev this should be the same direct connection as DATABASE_URL above. In production,
# where DATABASE_URL is routed through PgBouncer (transaction-mode pooling can't run
# migrations), this must instead point straight at Postgres, bypassing the pooler.
DIRECT_DATABASE_URL=postgresql://postgres:password@localhost:5432/chatlogix
# PgBouncer admin console (SHOW CONFIG / SHOW POOLS). Optional — derived from
# DIRECT_DATABASE_URL on port 6432 / database pgbouncer when unset.
# PGBOUNCER_ADMIN_URL=postgresql://postgres:password@host:6432/pgbouncer
# Only set these when DATABASE_URL is routed through PgBouncer (production PM2 +
# Lambda functions) — leave unset for local dev, which talks to Postgres directly.
# DATABASE_CONNECTION_LIMIT=8
# DATABASE_POOL_TIMEOUT=8

# Optional Redis (not yet used broadly)
REDIS_URL=redis://localhost:6379

# Queueing
QUEUE_PROVIDER=sqs
AWS_REGION=ap-south-1
# WhatsApp media bucket region (may differ from AWS_REGION / SQS).
# chatlogix-wa-media lives in us-east-1.
WA_MEDIA_S3_BUCKET=
WA_MEDIA_S3_REGION=us-east-1
# For LocalStack SQS. Comment out when using real AWS.
AWS_SQS_ENDPOINT=http://localhost:4566
# Use dummy credentials for LocalStack; set real ones in CI/prod
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# AWS_SESSION_TOKEN=

# SQS queue URLs (fill after running `npm run queues:init` against LocalStack OR set real ARNs)
# Canonical inbound text queue (production: chatlogix-text-queue-prod)
TEXT_QUEUE_URL=http://localhost:4566/000000000000/text-queue
# Outbound replies to WhatsApp (production: chatlogix-response-queue-prod)
RESPONSE_QUEUE_URL=http://localhost:4566/000000000000/response-queue
# Media fetch/transcribe jobs (production: chatlogix-media-fetch-queue-prod)
MEDIA_FETCH_QUEUE_URL=http://localhost:4566/000000000000/media-fetch-queue
# Audio messages after Whisper transcription (production: chatlogix-audio-queue-prod)
AUDIO_QUEUE_URL=http://localhost:4566/000000000000/audio-queue
# Image messages with caption ready for AI (production: chatlogix-image-queue-prod)
IMAGE_QUEUE_URL=http://localhost:4566/000000000000/image-queue
# DEPRECATED alias for TEXT_QUEUE_URL. Code falls back to this if TEXT_QUEUE_URL is unset.
# INCOMING_QUEUE_URL=

# WhatsApp (Meta) credentials
WHATSAPP_VERIFY_TOKEN=replace-with-random-secret
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Set to 'true' only for local dev when you cannot forward the correct signature
DISABLE_WEBHOOK_SIGNATURE=false

# Graph API base URLs. Leave unset for production — the defaults below are the
# real Meta endpoints. Override BOTH together to point at the load-test mock
# (see docs/LOAD_TESTING.md). Overriding only the first still leaves the typing
# indicator hitting real Meta on every message.
# WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com/v18.0
# WHATSAPP_TYPING_GRAPH_BASE_URL=https://graph.facebook.com/v21.0

# AI
OPENAI_API_KEY=your-openai-api-key-here

# Catalog import uploads. Production needs a real bucket (presigned PUT).
# Leave unset in local dev — files are stored under backend/.tmp/catalog-imports/.
# CATALOG_IMPORT_S3_BUCKET=chatlogix-s3-frontend
# CATALOG_IMPORT_S3_REGION=ap-south-1
# Request-count limits (1 brochure read / hour) apply in production only.
# Set true to skip them in production; local/dev already skips them.
# CATALOG_IMPORT_DISABLE_RATE_LIMIT=true
# Daily AI spend caps — FALLBACK only. Live values are PlatformSettings
# catalogImportDailyPaiseCap / catalogEnhanceDailyPaiseCap (paise = milli ÷ 10).
# Defaults: 50000 milli = ₹50, 30000 milli = ₹30.
# CATALOG_IMPORT_DAILY_MILLI_CAP=50000
# CATALOG_ENHANCE_DAILY_MILLI_CAP=30000

# Multi-Stage AI Pipeline
# Set to 'true' to enable the multi-stage AI pipeline for all conversations.
# Set to 'false' to use the legacy single-stage processor.
# Use MULTI_STAGE_AI_ROLLOUT_PERCENTAGE for a gradual rollout (0-100).
# When both are set, ENABLE_MULTI_STAGE_AI='true'/'false' takes precedence.
ENABLE_MULTI_STAGE_AI=true
MULTI_STAGE_AI_ROLLOUT_PERCENTAGE=100

# Wallet billing fallbacks (millirupees: 1 rupee = 1000 milli).
# Live knobs are the PlatformSettings row (money in paise). These env vars
# seed that row and are last-resort when Redis/DB are empty. Edit from
# GET/PATCH /api/admin/settings — do not treat these as the live source.
# Every billable action charges
#   (AI cost + WhatsApp cost + platform fee) x (1 + Vendor.markupPercent/100)
# rounded up once at the charge boundary. markupPercent is per-vendor in the DB
# (default 50). The WhatsApp cost slot stays 0 until the per-message rate card
# lands (P2h).
# USD -> INR fallback. Live rate is PlatformSettings (override ?? Frankfurter).
USD_TO_INR_RATE=83
# Boot-time + 24h background Frankfurter refresh. Unset = production only, so a
# local process sharing the remote database never writes PlatformSettings or
# FxRateHistory on restart. 'true' forces it on (staging), 'false' forces it off
# everywhere. POST /api/admin/settings/refresh-fx and the fxRateRefresh Lambda
# ignore this flag — they always refresh.
# FX_REFRESH_ENABLED=true
# Fixed platform fee fallback, in millirupees (live: *Paise on PlatformSettings).
PLATFORM_FEE_PER_TURN_MILLI=0
PLATFORM_FEE_OUTBOUND_MEDIA_MILLI=0

# Auth — vendor phone OTP. Production requires FIREBASE_API_KEY (Identity Toolkit SMS).
# Comma-separated admin phones in E.164 (e.g. +919876543210)
AUTH_ADMIN_PHONES=
# Access JWT lifetime (default 1h). AUTH_TOKEN_EXPIRES_IN is a deprecated alias.
AUTH_ACCESS_TOKEN_EXPIRES_IN=1h
# AUTH_TOKEN_EXPIRES_IN=1h
# Refresh token / session cookie lifetime (default 7d)
AUTH_REFRESH_TOKEN_EXPIRES_IN=7d
# Set Secure flag on refresh cookie (defaults to true in production)
# AUTH_COOKIE_SECURE=true
# Comma-separated browser origins allowed to send credentials (CORS)
# Production: https://app.chatlogix.in,https://admin.chatlogix.in,https://www.chatlogix.in,https://chatlogix.in
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Trial wallet fallbacks (millirupees; 50000 = ₹50.00). Live: trialGrantPaise / trialExpiryDays.
TRIAL_GRANT_MILLI=50000
TRIAL_EXPIRY_DAYS=30
# Vendor wallet top-up (P2g). WALLET_PAYMENT_PROVIDER stays env-only (razorpay is still 501).
# Amounts / presets / mock flag are fallbacks for PlatformSettings (paise = milli ÷ 10).
# Millirupees: min ₹100, max ₹50,000, presets ₹500 / ₹1,000 / ₹2,000 / ₹5,000.
WALLET_PAYMENT_PROVIDER=mock
MIN_WALLET_TOPUP_MILLI=100000
MAX_WALLET_TOPUP_MILLI=50000000
WALLET_TOPUP_PRESETS_MILLI=500000,1000000,2000000,5000000
MOCK_WALLET_TOPUP_ENABLED=true
# Local/test hardcoded OTP 123456 when FIREBASE_API_KEY is unset. Set false to disable (503).
# Ignored in production — Firebase is always required there.
AUTH_ALLOW_DEV_OTP=true
# Web API key from Firebase Console → Project settings → General. Required in production.
FIREBASE_API_KEY=
# Admin SDK service account (not required to send SMS)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# FIREBASE_SERVICE_ACCOUNT_KEY_PATH=
