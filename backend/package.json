{
  "name": "chatlogix-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development node --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "db:test": "tsx scripts/test-db-connection.ts",
    "db:import": "tsx scripts/import-database-backup.ts",
    "worker:incoming": "cross-env WORKER_TYPE=incoming node --loader ts-node/esm --experimental-specifier-resolution=node src/workers/incomingMessageWorker.ts",
    "worker:text": "cross-env WORKER_TYPE=text node --loader ts-node/esm --experimental-specifier-resolution=node src/workers/textWorker.ts",
    "worker:response": "cross-env WORKER_TYPE=response node --import tsx src/workers/responseWorker.ts",
    "worker:multi-stage": "cross-env WORKER_TYPE=multi_stage_ai node --import tsx src/workers/multiStageAIWorker.ts",
    "worker:conversation": "cross-env WORKER_TYPE=conversation node --import tsx src/workers/conversationWorker.ts",
    "worker:media": "cross-env WORKER_TYPE=media node --import tsx src/workers/mediaWorker.ts",
    "test:multi-stage": "tsx scripts/test-multi-stage-worker.ts",
    "check:multi-stage": "tsx scripts/check-multi-stage-config.ts",
    "queues:init": "cross-env NODE_ENV=development node --import tsx ./scripts/init-queues.ts",
    "deploy:lambda": "cross-env NODE_ENV=production node --loader ts-node/esm --experimental-specifier-resolution=node ./scripts/deploy-lambda.ts",
    "deploy:lambda:staging": "cross-env NODE_ENV=staging node --loader ts-node/esm --experimental-specifier-resolution=node ./scripts/deploy-lambda.ts --environment staging",
    "lambda:list": "cross-env NODE_ENV=production node --loader ts-node/esm --experimental-specifier-resolution=node ./scripts/deploy-lambda.ts --list",
    "monitor:db-failures": "cross-env NODE_ENV=production node --loader ts-node/esm --experimental-specifier-resolution=node ./scripts/monitor-db-failures.ts",
    "test": "vitest run",
    "test:intent-classification": "tsx scripts/test-intent-classification.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.917.0",
    "@aws-sdk/client-iam": "^3.917.0",
    "@aws-sdk/client-lambda": "^3.917.0",
    "@aws-sdk/client-s3": "^3.917.0",
    "@aws-sdk/client-sqs": "^3.637.0",
    "@aws-sdk/s3-request-presigner": "^3.967.0",
    "@prisma/client": "^5.17.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.2.1",
    "firebase-admin": "^13.6.0",
    "helmet": "^7.1.0",
    "image-size": "^1.1.1",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-fetch": "^3.3.2",
    "openai": "^6.5.0",
    "pino": "^9.3.2",
    "pino-http": "^9.0.0",
    "pino-rotating-file-stream": "^0.0.2",
    "rate-limit-redis": "^4.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.131",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.11.30",
    "@types/swagger-ui-express": "^4.1.8",
    "cross-env": "^7.0.3",
    "date-fns-tz": "^3.2.0",
    "pino-pretty": "^11.3.0",
    "prisma": "^5.17.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.6.2",
    "vitest": "^2.1.3"
  }
}
