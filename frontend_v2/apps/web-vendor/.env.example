# Backend API URL
VITE_API_URL=http://localhost:8000/api

# reCAPTCHA Site Key
# IMPORTANT: This must match the site key configured in Firebase Console
# Get it from: Firebase Console → Authentication → Settings → reCAPTCHA
# DO NOT use Google's test keys - they won't work with Firebase
# See ../RECAPTCHA_SETUP.md for detailed instructions
VITE_RECAPTCHA_SITE_KEY=

# Environment (development/staging/production)
VITE_ENVIRONMENT=development

# Onboarding help footer + rejected-application support link.
# Digits only, no + or spaces (e.g. 919876543210).
# If unset, the footer falls back to VITE_SUPPORT_EMAIL, then to https://chatlogix.in.
VITE_SUPPORT_WHATSAPP=

# Optional mailto fallback for the onboarding help footer.
VITE_SUPPORT_EMAIL=
